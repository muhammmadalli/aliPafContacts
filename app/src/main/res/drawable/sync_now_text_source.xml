<!-- res/drawable/ic_sync_now.xml -->
<vector xmlns:android="http://android.com"
    android:width="500dp"
    android:height="500dp"
    android:viewportWidth="500"
    android:viewportHeight="500">
    
    <!-- Android Vector Asset Studio automatically handles shapes, -->
    <!-- but text strings must be converted to vector paths first. -->
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="100%" height="100%">
    <text x="50%" y="42%" font-family="system-ui, -apple-system, sans-serif" font-size="90" font-weight="900" fill="black" text-anchor="middle" dominant-baseline="central">SYNC</text>
    <text x="50%" y="62%" font-family="system-ui, -apple-system, sans-serif" font-size="90" font-weight="900" fill="black" text-anchor="middle" dominant-baseline="central">NOW</text>
    </svg>


</vector>
